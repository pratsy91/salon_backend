PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/salon?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
CORS_ORIGIN=*

# Optional. Centre of the seeded salon's geo-fence, so you can test check-in
# from wherever you are. Defaults to 22.7196 / 75.8577.
SEED_SALON_LAT=
SEED_SALON_LNG=
